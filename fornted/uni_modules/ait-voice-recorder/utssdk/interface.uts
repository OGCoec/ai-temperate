export type AitVoiceRecorderFailure = {
  code: string
  message: string
}

export type AitVoicePermissionOptions = {
  onGranted: () => void
  onDenied: (permanent: boolean) => void
}

export type AitVoiceRecorderOptions = {
  diagnosticRunId: string
  onFrame: (
    payloadBase64: string,
    declaredByteLength: number,
    frameSequence: number
  ) => void
  onStarted: () => void
  onStopped: () => void
  onError: (failure: AitVoiceRecorderFailure) => void
}

/**
 * 定义 Android 录音权限请求 API，权限结果继续通过原有回调返回。
 */
export type RequestRecordPermissionApi =
  (options: AitVoicePermissionOptions) => void

/**
 * 定义 Android PCM 录音启动 API，只返回可安全跨越 UTS 桥的原生录音编号。
 */
export type StartRecordingApi =
  (options: AitVoiceRecorderOptions) => number

/**
 * 定义 Android PCM 录音续约 API，布尔结果表示编号是否仍指向当前活动录音。
 */
export type RenewRecordingLeaseApi =
  (recordingId: number) => boolean

/**
 * 定义 Android PCM 录音停止 API，布尔结果表示是否命中并停止当前活动录音。
 */
export type StopRecordingApi =
  (recordingId: number) => boolean
