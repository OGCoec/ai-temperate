export type AitVoiceRecorderFailure = {
  code: string
  message: string
}

export type AitVoicePermissionOptions = {
  onGranted: () => void
  onDenied: (permanent: boolean) => void
}

export type AitVoiceRecorderOptions = {
  onFrame: (frame: ArrayBuffer) => void
  onStarted: () => void
  onStopped: () => void
  onError: (failure: AitVoiceRecorderFailure) => void
}

export type AitVoiceRecorderSession = {
  stop: () => void
}

/**
 * 定义 Android 录音权限请求 API，权限结果继续通过原有回调返回。
 */
export type RequestRecordPermissionApi =
  (options: AitVoicePermissionOptions) => void

/**
 * 定义 Android PCM 录音启动 API，返回值继续提供可重复调用的停止操作。
 */
export type StartRecordingApi =
  (options: AitVoiceRecorderOptions) => AitVoiceRecorderSession
