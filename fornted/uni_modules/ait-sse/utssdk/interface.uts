export type AitSseFailure = {
  code: string
  stage: string
  exceptionType: string
  statusCode: number
  message: string
  contentType: string
  cfMitigated: string
  cfRay: string
  elapsedMs: number
  readCount: number
  byteCount: number
  closedByCaller: boolean
  retryable: boolean
}

export type AitSseDiagnostic = {
  stage: string
  event: string
  statusCode: number
  contentType: string
  cfRay: string
  elapsedMs: number
  readCount: number
  byteCount: number
  lastReadElapsedMs: number
  closedByCaller: boolean
}

export type AitSseOpen = {
  statusCode: number
  sessionRenewed: string
  newAccessToken: string
  contentType: string
  cfMitigated: string
  cfRay: string
  traceId: string
  usagePublicId: string
}

export type AitSseRequestOptions = {
  url: string
  method: string
  headers: UTSJSONObject
  body: string
  onOpen: (renewal: AitSseOpen) => void
  onChunk: (chunk: string) => void
  onDiagnostic: (diagnostic: AitSseDiagnostic) => void
  onError: (failure: AitSseFailure) => void
  onClosed: () => void
}

export type AitSseConnection = {
  close: (callerInitiated: boolean) => void
}

/**
 * 打开只允许 HTTPS 的 POST JSON SSE，并允许调用方主动取消底层连接。
 */
export function openSseRequest(options: AitSseRequestOptions): AitSseConnection
