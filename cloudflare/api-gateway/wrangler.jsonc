{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-temperate-api-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-07-24",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "niko000o.site/api/*",
      "zone_name": "niko000o.site"
    },
    {
      "pattern": "niko000o.site/v1/*",
      "zone_name": "niko000o.site"
    },
    {
      "pattern": "niko000o.site/ws/voice",
      "zone_name": "niko000o.site"
    },
    {
      "pattern": "niko000o.site/__edge/android-clearance",
      "zone_name": "niko000o.site"
    },
    {
      "pattern": "niko000o.site/__edge/android-clearance/status",
      "zone_name": "niko000o.site"
    },
    {
      "pattern": "admin.niko000o.site/api/*",
      "zone_name": "niko000o.site"
    }
  ],
  "vars": {
    "API_UPSTREAM_ORIGIN": "https://api.niko000o.site",
    "SSE_ROUTE_LOG_SAMPLE_RATE": "0.05"
  }
}
