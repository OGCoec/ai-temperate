{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-temperate-api-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-07-24",
  "workers_dev": false,
  "preview_urls": false,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true
    }
  },
  "routes": [
    {
      "pattern": "niko000o.site/*",
      "zone_name": "niko000o.site"
    },
    {
      "pattern": "admin.niko000o.site/api/*",
      "zone_name": "niko000o.site"
    }
  ],
  "vars": {
    "API_UPSTREAM_ORIGIN": "https://api.niko000o.site",
    "H5_PAGES_ORIGIN": "https://1759bd86.ai-temperate-frontend.pages.dev",
    "AUTH_EDGE_DIAGNOSTICS_ENABLED": "true",
    "AUTH_EDGE_SUCCESS_LOG_SAMPLE_RATE": "0.01",
    "ANDROID_APP_LINK_SHA256": "22:6D:16:0C:3C:1D:F7:30:92:8B:AA:A5:06:91:78:DB:9E:01:83:D4:A1:FA:B3:4C:45:ED:D5:18:2B:E8:37:F1",
    "API_KEY_STREAM_DIAGNOSTICS_ENABLED": "true",
    "SSE_ROUTE_LOG_SAMPLE_RATE": "0.05"
  }
}
